# Server
HOST=127.0.0.1
PORT=8765

# Translation provider: anthropic | openai | glm
TRANSLATION_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# GLM (ZhipuAI)
ZHIPUAI_API_KEY=
GLM_MODEL=glm-4-plus

# Metadata extraction can use a cheaper model; defaults to TRANSLATION_PROVIDER if unset
METADATA_PROVIDER=
METADATA_MODEL=

# Translation chunking: max characters per chunk sent to the LLM
TRANSLATION_CHUNK_CHARS=6000
